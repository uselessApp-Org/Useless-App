@page "/ChangePassword"
@using UselessApp.Services
@inject MongodbUserService MongodbUser
@inject DisplayNameService DisplayNameService
@inject NavigationManager nav

<h1 class="h1">Change Password</h1>

<div class="password-form">
    <label for="currentPassword">Current Password</label>
    <input type="password" id="currentPassword" @bind="currentPassword" />

    <label for="newPassword">New Password</label>
    <input type="password" id="newPassword" @bind="newPassword" />

    <label for="confirmPassword">Confirm Password</label>
    <input type="password" id="confirmPassword" @bind="confirmPassword" />
</div>

<button class="password-button" @onclick="ChangingPassword">
    Change Password
</button>

<p class="error">@errorMessage</p>
<p class="success">@Message</p>

<button class="close-button"
        @onclick='() => nav.NavigateTo("/account-settings")'>
    Close
</button>

@code{
    private string errorMessage = string.Empty;
    private string Message = string.Empty;
    
    private string currentPassword;
    private string newPassword;
    private string confirmPassword;
    
    private async Task ChangingPassword()
{
    var result = await MongodbUser.ValidateLoginAsync(
        DisplayNameService.Username,
        currentPassword);

    if (result.user == null)
    {
        errorMessage = "Current password is incorrect!";
        Message = string.Empty;
        return;
    }

    if (newPassword != confirmPassword)
    {
        errorMessage = "Passwords do not match!";
        Message = string.Empty;
        return;
    }

    await MongodbUser.ChangePasswordAsync(
        DisplayNameService.Username,
        newPassword);

    Message = "Password changed successfully!";
    errorMessage = string.Empty;
}
}