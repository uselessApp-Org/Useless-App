@page "/Displayname"
@using UselessApp.Services

@inject MongodbUserService MongodbUser
@inject DisplayNameService DisplayNameService
@inject NavigationManager nav

@rendermode InteractiveServer

<div class="displayname-container">

    <h2>Change Display Name</h2>

    <div class="name-preview">
        Current Name: <strong>@DisplayNameService.DisplayName</strong>
    </div>

    <div class="DisplayNameForm">
        <label for="displayName">New Display Name</label>
        <input type="text"
               id="displayName"
               @bind="newDisplayName" />
    </div>

    <button class="displayname-button"
            @onclick="ChangeDisplayName">
        Change Display Name
    </button>
    <button class="close-button"
        @onclick='() => nav.NavigateTo("/account-settings")'>
    Close
</button>

</div>

@code {
    private string newDisplayName;

    private async Task ChangeDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(newDisplayName))
        {
            await MongodbUser.ChangeDisplayNameAsync(
                DisplayNameService.Username,
                newDisplayName);

            await DisplayNameService.SetDisplayNameAsync(
                newDisplayName);

            await InvokeAsync(StateHasChanged);
        }
    }
}