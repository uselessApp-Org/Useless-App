@page "/arcade/{Feature}"
@rendermode InteractiveServer
@using UselessApp.Services
@inject IJSRuntime JS
<PageTitle>@Title | UselessApp</PageTitle>
<header class="page-heading"><p class="eyebrow">THE DEPARTMENT OF PRODUCTIVE NONSENSE</p><h1>@Title</h1><p>@Subtitle</p><a href="/">← All apps</a></header>
<section class="panel absurd-app @(Feature == "calculator" ? "arcade-calculator" : "")">
@if (Feature == "converter") {
 <h2>Ridiculous Measurements</h2>
 <div class="converter-sentence" aria-label="Convert an amount from one unit to another">
  <label class="converter-amount"><span>Amount</span><input class="form-control" type="number" min="0" step="any" placeholder="e.g. 100" @bind="amount" /></label>
  <div class="unit-picker"><label for="unit-from">From</label><button id="unit-from" type="button" class="form-control unit-trigger" aria-expanded="@fromOpen" @onclick="()=>ToggleUnits(true)">@(string.IsNullOrWhiteSpace(from)?"Choose a starting unit":from) <span>⌄</span></button>
   @if(fromOpen){<div class="unit-panel"><input class="form-control" placeholder="Search all units…" @bind="fromSearch" @bind:event="oninput" autocomplete="off" autofocus /><div class="unit-results">@foreach(var u in SourceMatches.Take(75)){<button type="button" @onclick="()=>PickFrom(u.Name)">@u.Name</button>}</div></div>}
  </div>
  <span class="sentence-to">to</span>
  <div class="unit-picker"><label for="unit-to">To</label><button id="unit-to" type="button" class="form-control unit-trigger" aria-expanded="@toOpen" @onclick="()=>ToggleUnits(false)">@(string.IsNullOrWhiteSpace(to)?"Choose a destination unit":to) <span>⌄</span></button>
   @if(toOpen){<div class="unit-panel"><input class="form-control" placeholder="Search compatible units…" @bind="toSearch" @bind:event="oninput" autocomplete="off" autofocus /><div class="unit-results">@foreach(var u in TargetMatches.Take(75)){<button type="button" @onclick="()=>PickTo(u.Name)">@u.Name</button>}</div></div>}
  </div><button type="button" class="btn btn-secondary converter-random" @onclick="RandomTarget">🎲 Random</button>
 </div>
 <div class="absurd-row"><span>Detected: <strong>@(kind == "mass" ? "Mass (kg reference)" : "Length (inches reference)")</strong> · @AbsurdConversions.Units.Length objects</span><label>Sort destination units <select class="form-control" @bind="unitSort"><option value="name">A–Z</option><option value="small">Smallest first</option><option value="large">Largest first</option></select></label></div>
 <label><input type="checkbox" @bind="bureaucracy" /> Bureaucracy Mode: paperwork before mathematics</label>
 @if(bureaucracy && !approved){<div class="absurd-paper"><h3>Application 42-B: Permission to Measure</h3><label>Your official reason<input class="form-control" @bind="reason" maxlength="100" /></label><label><input type="checkbox" @bind="agreed" /> I acknowledge that bananas are not standardized instruments.</label><button class="btn btn-secondary" disabled="@(!agreed || string.IsNullOrWhiteSpace(reason))" @onclick="()=>approved=true">Stamp approved</button></div>}
 else {<button class="btn btn-primary" @onclick="Convert">Convert, regrettably</button>}
 @if(!string.IsNullOrWhiteSpace(conversionError)){<p role="alert">@conversionError</p>}
 @if(conversion is not null){<div class="absurd-result" role="status"><h2>@conversion.Value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture) @to</h2><p>@amount @from is approximately @conversion.Value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture) @to.</p><p>@UnitNote</p><h3>Object journey</h3><div class="absurd-journey">@foreach(var i in Enumerable.Range(0,Math.Min(20,(int)Math.Min(20,Math.Ceiling(conversion.Value))))){<span title="One representative object">@UnitEmoji</span>}</div><p class="small-note">Showing up to 20 estimated objects. Values are illustrative, not exact animal/building measurements.</p></div>}
}
else if (Feature == "calculator") {
 <div class="calculator-intro"><span class="eyebrow">NUMBERS. WITH CONSEQUENCES.</span><h2>Choose your chaos</h2><p>Catch the answer, chase a jackpot, or take on a math boss.</p></div><label>Game mode<select class="form-control" @bind="calcMode" @bind:after="ResetCalcMode"><option>Catch Me</option><option>Slot Machine</option><option>Math Boss Fight</option></select></label>
 @if(calcMode != "Math Boss Fight"){
  @if(calcMode=="Catch Me"){<label>Expression<input class="form-control" @bind="expression" placeholder="(24 + 6) / 2" /></label>}
  @if(calcMode == "Catch Me") {<label>Difficulty<select class="form-control" @bind="dodgeDifficulty" @bind:after="ResetDodge"><option>Easy</option><option>Medium</option><option>Hard</option><option>Insane</option></select></label><div class="dodge-field"><button class="btn btn-primary runaway" style="--dodge-x:@(dodgeX)px;--dodge-y:@(dodgeY)px" @onmouseover="Dodge" @onclick="Calculate">= Catch me!</button></div>}
  else {
   <div class="slot-cabinet @(slotSpins>0 ? (slotWinner ? "is-jackpot" : "is-miss") : "")">
    <div class="slot-marquee"><span class="slot-bulb" aria-hidden="true"></span><div><span class="slot-kicker">THE HOUSE ALWAYS ADDS</span><h3>Lucky Numbers</h3></div><span class="slot-bulb" aria-hidden="true"></span></div>
    <div class="slot-expression"><label for="slot-expression">YOUR EXPRESSION<input id="slot-expression" class="form-control" @bind="expression" @bind:event="oninput" @bind:after="ClearSlotResult" placeholder="(24 + 6) / 2" autocomplete="off" spellcheck="false" /></label></div>
    <div class="slot-body">
     <div class="slot-reel-surround">
      <span class="slot-screen-label">@(slotSpins==0 ? "YOUR ANSWER AWAITS" : slotWinner ? "JACKPOT · CORRECT ANSWER" : "WRONG ANSWER · TRY AGAIN")</span>
      <div class="slot-readout" @key="slotSpins"><span>@(slotSpins==0 ? "? ? ?" : slotDisplay)</span></div>
      <div class="slot-screen-footer"><span>CALCULATED CHAOS</span><span aria-hidden="true">✦ ✦ ✦</span></div>
     </div>
     <button type="button" class="slot-handle @(leverPulled ? "is-pulled" : "")" @onclick="Spin" aria-label="Pull lever to spin"><span class="slot-handle-knob" aria-hidden="true"></span><span class="slot-handle-stem" aria-hidden="true"></span><span class="slot-handle-base" aria-hidden="true"></span><span class="slot-handle-caption">PULL</span></button>
    </div>
    <div class="slot-console">
     <div class="slot-scoreboard"><div><span>JACKPOTS</span><strong>@slotWins.ToString("D2")</strong></div><div><span>SPINS</span><strong>@slotSpins.ToString("D2")</strong></div><div><span>ODDS</span><strong>1 / 3</strong></div></div>
     <button type="button" class="slot-spin" @onclick="Spin"><span>SPIN FOR AN ANSWER</span><span aria-hidden="true">↻</span></button>
     <p class="slot-message" role="status">@(string.IsNullOrEmpty(calcResult) ? "One expression. Three-to-one odds. Questionable mathematics." : calcResult)</p>
    </div>
    <div class="slot-cabinet-foot"><span>NO COINS REQUIRED</span><span>NO REFUNDS ON MATH</span></div>
   </div>
  }
  @if(calcMode=="Catch Me"){<p class="absurd-result animated-digits" role="status">@calcResult</p>}
 } else {
  <div class="absurd-row"><label>Boss difficulty<select class="form-control" @bind="bossDifficulty" @bind:after="RestartBattle"><option>Easy</option><option>Normal</option><option>Hard</option><option>Nightmare</option></select></label><label>Answer style<select class="form-control" @bind="bossAnswerMode" @bind:after="NextQuestion"><option>Multiple Choice</option><option>Type Answer</option></select></label></div><h3>Battle @bossLevel: @bossName</h3><div class="absurd-row"><div>🧙 You: @playerHp HP <progress max="100" value="@playerHp"></progress></div><div>👹 Boss: @bossHp HP <progress max="100" value="@bossHp"></progress></div></div>
  <p class="absurd-big">@questionA @questionOperator @questionB = ?</p>
  @if(bossAnswerMode=="Multiple Choice"){<div class="trivia-options">@foreach(var choice in BossChoices){<button class="btn btn-secondary" @onclick="()=>AttackChoice(choice)">@choice</button>}</div>}else{<div class="absurd-row"><input class="form-control" type="number" aria-label="Your answer" placeholder="Your answer" @bind="bossAnswer" /><button class="btn btn-primary" @onclick="Attack">Attack</button></div>}<button class="btn btn-secondary" @onclick="RestartBattle">Restart</button>
  <p role="status">@battleMessage</p>
 }
}
else if (Feature == "counter") {
 <h2>Achievements & Speed Clicking</h2><label>Mode<select class="form-control" @bind="speedMode" @bind:after="ResetSpeed"><option value="normal">Endless clicking</option><option value="five">5-second CPS test</option><option value="ten">10-second CPS test</option><option value="free">Freestyle: fastest rolling second</option></select></label>
 <div class="absurd-big" role="status">@count</div><button class="btn btn-primary" @onclick="ClickCounter">Pointless +1</button> <button class="btn btn-secondary" @onclick="ResetSpeed">Reset round</button>
 <p>Lifetime clicks: @lifetime | Current CPS: @currentCps.ToString("F2") | Best 1-second: @peakCps.ToString("F0") CPS</p>
 <p>5-second best: @bestFive.ToString("F2") CPS · 10-second best: @bestTen.ToString("F2") CPS</p>
 <p role="status">@speedStatus</p><h3>Achievements</h3><div class="achievements-grid">@foreach(var milestone in milestones){<p>@(lifetime>=milestone?"🏆":"🔒") @milestone clicks — @AchievementName(milestone)</p>}</div>
}
else if (Feature == "todo") {
 <h2>To-Don't Excuse Office</h2><div class="absurd-row"><input class="form-control" maxlength="100" placeholder="Task you aren't doing" @bind="taskInput" /><button class="btn btn-primary" @onclick="AddTask">Submit excuse request</button></div>
 @foreach(var t in tasks){<div class="absurd-paper"><strong>@t.Name</strong><p>@t.Excuse</p><button class="btn btn-secondary" @onclick="()=>Reroll(t)">New excuse</button> <button class="btn btn-secondary" @onclick="()=>tasks.Remove(t)">Remove</button></div>}
}
else if (Feature == "translator") {
 <h2>Personality translator</h2><label>Voice <select class="form-control" @bind="voice">@foreach(var m in modes){<option>@m</option>}</select></label>
 <label>Message <textarea class="form-control" maxlength="2000" rows="4" @bind="translationInput" /></label><button class="btn btn-primary" @onclick="()=>translation=PersonalityTranslations.Translate(translationInput,voice)">Translate</button>
 <div class="absurd-result" role="status">@translation</div><p class="small-note">Gen Z works both ways: cool → skibidi; charm/charisma → rizz; rizz → charm or charisma. Phrase substitution, not full grammatical machine translation.</p>
}
else if (Feature == "travel") {
 <h2>Trip Fortune</h2><label>Destination <input class="form-control" maxlength="100" @bind="destination" placeholder="Eau Claire, Wisconsin" /></label><button class="btn btn-primary" @onclick="Foretell">Consult the oracle</button>
 @if(travelResult.Length>0){<div class="absurd-result"><h3>Officially unofficial prophecy</h3><p>@travelResult</p><h3>Completely fictional weather</h3><p>@fictionalWeather</p><button class="btn btn-secondary" @onclick="Foretell">Another omen</button></div>}
}
else if (Feature == "trivia") {
 <h2>Trick Trivia: Three Fit, One Doesn't</h2><p>Three answers fit the question. Pick the odd one out. These questions use wordplay and subtle exceptions rather than obvious “which is NOT?” wording.</p>
 <h3>@CurrentQuestion.Prompt</h3><div class="trivia-options">@for(int i=0;i<4;i++){var choice=i;<button disabled="@answered" class="btn btn-secondary" @onclick="()=>ChooseTrivia(choice)">@triviaAnswers[i]</button>}</div>
 <p role="status">@triviaFeedback</p><p>Score: @triviaScore / @triviaAttempts</p><button class="btn btn-primary" @onclick="NewTrivia">Next question</button>
}
else if (Feature == "soundboard") {
 <h2>Completely unnecessary soundboard</h2><p>Generated with Web Audio. No copyrighted audio packs or network calls.</p><label>Volume <input type="range" min="0" max="100" @bind="volume" /></label><div class="absurd-keys">@foreach(var sound in sounds){<button class="btn btn-secondary" @onclick="()=>PlaySound(sound)">🔊 @sound</button>}</div>
}
else if (Feature == "rock") {
 <h2>Virtual pet rock</h2><label>Name your rock <input class="form-control" maxlength="40" @bind="rockName" /></label><div class="rock-face" aria-label="A rock with a completely indifferent expression">🪨</div><h3>@rockName</h3><p>Emotion: indifference. Care actions: @rockActions. Status: remarkably stationary.</p>
 <button class="btn btn-primary" @onclick="FeedRock">Feed</button> <button class="btn btn-secondary" @onclick="PetRock">Pet</button> <button class="btn btn-secondary" @onclick="SleepRock">Nap</button>
 <p role="status">@rockMessage</p>
}
else if (Feature == "bubbles") {
 <h2>Infinite Bubble Wrap</h2><p class="small-note">A premium stress-relief service with absolutely no productive outcome.</p>
 <div class="bubble-stats" role="status"><div><span>Available points</span><strong>@points</strong></div><div><span>Lifetime earned</span><strong>@totalBubblePoints</strong></div><div><span>Popped</span><strong>@pops</strong></div><div><span>Sheets completed</span><strong>@sheets</strong></div><div><span>Combo</span><strong>×@BubbleMultiplier</strong></div></div>
 <div class="bubble-actions"><button class="btn btn-secondary" @onclick="NewSheet">↻ Fresh sheet</button><button class="btn btn-secondary" disabled="@(points < 30 || goldBubbles)" @onclick="BuyUpgrade">@(goldBubbles ? "✓ Golden bubbles unlocked" : "✨ Gold bubbles · 30 pts")</button><button class="btn btn-secondary" disabled="@(points < 50 || doublePoints)" @onclick="BuyDouble">@(doublePoints ? "✓ Double points unlocked" : "⚡ Double points · 50 pts")</button></div>
 <div class="bubble-wrap-frame"><div class="bubble-grid" aria-label="25 bubble wrap buttons">@for(int i=0;i<bubbles.Length;i++){var index=i;<button class="bubble @(bubbles[i]?"popped":"")" data-gold="@goldBubbles" disabled="@bubbles[i]" aria-label="Bubble @(i+1), @(bubbles[i]?"popped":"ready to pop")" @onclick="()=>Pop(index)"><span class="bubble-highlight"></span></button>}</div></div>
 <p class="bubble-feedback" role="status">@bubbleMessage</p>
 <p class="small-note">+@BaseBubblePoints points per pop · Every 5 consecutive pops adds a combo bonus, up to ×3. Complete a sheet for +10 points.</p>
}
else {<h2>Page not found</h2><a href="/">Return home</a>}
</section>
