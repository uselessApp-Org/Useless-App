@page "/arcade-extra/{Game}"
@rendermode InteractiveServer
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>@Title | UselessApp</PageTitle>
<header class="page-heading"><p class="eyebrow">MORE QUESTIONABLE ACTIVITIES</p><h1>@Title</h1><p>@Subtitle</p><a href="/#other-apps">← Other apps</a></header>
<section class="panel extra-game">
@if(Game=="gym"){
 <h2>Password Strength Gym</h2><p>Train your imaginary lifter by typing a <strong>made-up example password</strong>. Real passwords are best kept out of demos. This input runs entirely in browser JavaScript; no password is sent to the Blazor server, stored, or logged.</p>
 <div id="local-password-gym"><label for="private-gym-password">Training password</label><input id="private-gym-password" data-private-password class="form-control" type="password" autocomplete="off" spellcheck="false" placeholder="Try a fictional password" /><div class="gym-platform" aria-hidden="true"><div class="gym-lifter" data-gym-lifter>🏋️</div></div><div class="gym-progress"><span data-gym-bar></span></div><p data-gym-result role="status">Enter a made-up password to start lifting.</p></div>
 <p class="small-note">Estimates are educational, not a crack-time guarantee. Length, predictable patterns, and character variety affect the lifting estimate.</p>
}
else if(Game=="coin"){
 <h2>Ultimate Coin Flip Championship</h2><p>Pick a side. Watch a needlessly dramatic coin toss. Every flip is generated with a fair 50/50 browser random draw.</p>
 <div class="extra-row"><label>Your call <select class="form-control" @bind="coinPick"><option>Heads</option><option>Tails</option></select></label><button class="btn btn-primary" disabled="@flipping" @onclick="Toss">@(flipping?"In slow motion…":"FLIP THE COIN")</button><button class="btn btn-secondary" @onclick="ResetCoin">Reset standings</button></div>
 <div class="championship-coin" data-coin-disk id="coin-arena">?</div><h3 role="status">@coinCommentary</h3>
 <div class="extra-stats"><span>Wins: <strong>@coinWins</strong></span><span>Losses: <strong>@coinLosses</strong></span><span>Heads: <strong>@heads</strong></span><span>Tails: <strong>@tails</strong></span><span>Streak: <strong>@coinStreak</strong></span></div>
}
else if(Game=="captcha"){
 <h2>Unnecessary CAPTCHA</h2><p>Prove you're human by spotting the one item that is suspiciously out of place. These are puzzle challenges, <strong>not real security verification</strong>.</p>
 <div class="extra-stats"><span>Challenge @(captchaLevel+1)</span><span>Score: @captchaScore</span><span>Lives: @captchaLives</span></div>
 <p class="small-note">@Challenges.Length different investigations · Answer locations change between rounds.</p><h3>@CaptchaPrompt</h3><div class="captcha-grid">@for(var i=0;i<captchaOptions.Length;i++){var choice=i;<button class="captcha-tile" disabled="@captchaAnswered" @onclick="()=>AnswerCaptcha(choice)"><span>@captchaOptions[i].Icon</span><small>@captchaOptions[i].Caption</small></button>}</div><p role="status">@captchaMessage</p>
 @if(captchaAnswered){<button class="btn btn-primary" @onclick="NextCaptcha">Next investigation →</button>}
 <button class="btn btn-secondary" @onclick="RestartCaptcha">Start over</button>
}
else if(Game=="rps"){
 <h2>Rock Paper Scissors Championship</h2><p>Best of five against increasingly odd opponents. No difficulty menu; the opponents grow smarter as you progress.</p>
 <div class="extra-stats"><span>Round: @rpsRound / 5</span><span>You: @rpsPlayer</span><span>@RpsOpponentName: @rpsCpu</span></div>
 <h3>Opponent: @RpsOpponentName</h3><p>@rpsFlavor</p>
 <p>Career wins: @rpsCareerWins · Career losses: @rpsCareerLosses · Win streak: @rpsStreak · Longest streak: @rpsBestStreak</p>
 <div class="rps-choices">@foreach(var move in rpsMoves){var m=move;<button class="rps-choice" disabled="@(rpsRound>5)" @onclick="()=>PlayRps(m)"><span class="rps-icon">@MoveIcon(m)</span><strong>@m</strong></button>}</div>
 <p role="status">@rpsMessage</p><p>Titles earned: @rpsTitles</p><button class="btn btn-secondary" @onclick="NewRpsTournament">New championship</button>
}
else if(Game=="platformer"){
 <h2>One-Button Platformer</h2><p>One button does everything. Press to jump; press again midair for a second jump. Time your landings to dodge obstacles.</p>
 <div class="platformer-settings"><label>Course difficulty <select class="form-control" id="platformer-difficulty"><option value="easy">Easy</option><option value="normal" selected>Normal</option><option value="hard">Hard</option><option value="nightmare">Nightmare</option></select></label><label>Course <select class="form-control" id="platformer-course"><option value="classic">Classic Run</option><option value="hurdles">Hurdle Hop</option><option value="chaos">Chaos Course</option><option value="marathon">Marathon</option></select></label></div><canvas id="one-button-course" width="600" height="300" aria-label="Side scrolling obstacle course" class="one-button-canvas"></canvas><div class="extra-row"><button id="one-button-course-jump" class="btn btn-primary" type="button">JUMP / DOUBLE JUMP / RESTART</button><button class="btn btn-secondary" @onclick="RestartPlatformer">Restart level</button></div><p class="small-note">Space or ↑ works on a keyboard. On mobile, use the Jump button. Press again after losing to retry.</p>
}
else{<h2>Unknown game</h2><a href="/">Go home</a>}
</section>
