@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter | UselessApp</PageTitle>
<header class="page-heading">
    <p class="eyebrow">TOOL 01 / KEEP COUNTING</p>
    <h1>Counter</h1>
    <p>Count up, count down, or admit you have lost count.</p>
</header>
<section class="panel counter-panel" aria-label="Counter tool">
    <p role="status" aria-live="polite">Current count: @count</p>
    <div class="counter-number" aria-hidden="true">@count</div>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <button type="button" class="btn btn-primary" @onclick="Increment">+1</button>
        <button type="button" class="btn btn-secondary" @onclick="Decrement">-1</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Reset">Reset</button>
    </div>
</section>

@code {
    private int count;
    private void Increment() => count++;
    private void Decrement() => count--;
    private void Reset() => count = 0;
}
