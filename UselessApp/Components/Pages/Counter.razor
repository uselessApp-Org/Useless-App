@page "/counter"

<style>
    /* Prevent clicking, pausing, right-clicking, etc. */
    .unstoppable {
        pointer-events: none;
        user-select: none;
    }
</style>

<iframe class="unstoppable"
        width="1500"
        height="630"
        src="https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&mute=0&controls=0&disablekb=1&loop=1&playlist=dQw4w9WgXcQ"
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen>
</iframe>
