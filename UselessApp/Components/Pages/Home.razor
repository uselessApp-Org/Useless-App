@page "/"
@using UselessApp.Services
@rendermode InteractiveServer
@inject MongodbUserService MongodbUserService
<PageTitle>Home</PageTitle>

<h1>Hello, world! Added Tests</h1>



<InputText @bind-Value="newUser.Username" placeholder="Username" />

<InputText @bind-Value="newUser.Password" 
           type="password" 
           placeholder="Password" />




<button @onclick="AddUser">Add User</button>


@code {
    private User newUser = new User { Username = string.Empty, Password = string.Empty };

    private async Task AddUser()
{
    await MongodbUserService.AddUserAsync(newUser);

    // Force a clean UI re-render
    newUser = new User { Username = string.Empty, Password = string.Empty };
    StateHasChanged();
}

}
