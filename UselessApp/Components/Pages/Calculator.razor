@page "/calculator"
@using UselessApp.Components.Calculator
@using UselessApp.Services
@inject CalculatorEvaluatorService Evaluator
@rendermode InteractiveServer

<PageTitle>Calculator</PageTitle>

<div class="CalcContainer">
    <ScientificKeypad ButtonClicked="HandleButtonClick" />

    <div class="CalcLayout">
        <div class="Display">
            @DisplayString
        </div>
        <div class="MainButtons">
            <CalcButton Style="Zero" Value="CLEAR" Clicked="HandleButtonClick">CLEAR</CalcButton>
            <CalcButton Value="/" Clicked="HandleButtonClick">/</CalcButton>
            <CalcButton Value="*" Clicked="HandleButtonClick">*</CalcButton>

            <CalcButton Value="@numpadDigits[0]" Clicked="HandleButtonClick">@numpadDigits[0]</CalcButton>
            <CalcButton Value="@numpadDigits[1]" Clicked="HandleButtonClick">@numpadDigits[1]</CalcButton>
            <CalcButton Value="@numpadDigits[2]" Clicked="HandleButtonClick">@numpadDigits[2]</CalcButton>
            <CalcButton Value="-" Clicked="HandleButtonClick">-</CalcButton>

            <CalcButton Value="@numpadDigits[3]" Clicked="HandleButtonClick">@numpadDigits[3]</CalcButton>
            <CalcButton Value="@numpadDigits[4]" Clicked="HandleButtonClick">@numpadDigits[4]</CalcButton>
            <CalcButton Value="@numpadDigits[5]" Clicked="HandleButtonClick">@numpadDigits[5]</CalcButton>
            <CalcButton Value="+" Clicked="HandleButtonClick">+</CalcButton>

            <CalcButton Value="@numpadDigits[6]" Clicked="HandleButtonClick">@numpadDigits[6]</CalcButton>
            <CalcButton Value="@numpadDigits[7]" Clicked="HandleButtonClick">@numpadDigits[7]</CalcButton>
            <CalcButton Value="@numpadDigits[8]" Clicked="HandleButtonClick">@numpadDigits[8]</CalcButton>
            <CalcButton Style="Enter" Value="ENTER" Clicked="HandleButtonClick">ENTER</CalcButton>

            <CalcButton Style="Zero" Value="0" Clicked="HandleButtonClick">0</CalcButton>
            <CalcButton Value="." Clicked="HandleButtonClick">.</CalcButton>
        </div>
    </div>
</div>

@code {
    private List<string> displayTokens = new List<string>();
    private string currentNumber = "";
    private List<string> numpadDigits = new() { "1", "2", "3", "4", "5", "6", "7", "8", "9" };
    private Random rng = new();

    private string DisplayString
    {
        get
        {
            string fullExpression = string.Join("", displayTokens) + currentNumber;
            return string.IsNullOrEmpty(fullExpression) ? "0" : fullExpression;
        }
    }

    private void ShuffleDigits()
    {
        numpadDigits = numpadDigits.OrderBy(_ => rng.Next()).ToList();
    }

    private void FlushCurrentNumber()
    {
        if (!string.IsNullOrEmpty(currentNumber))
        {
            displayTokens.Add(currentNumber);
            currentNumber = "";
        }
    }

    private void HandleButtonClick(string value)
    {
        if (value == "CLEAR")
        {
            currentNumber = "";
            displayTokens.Clear();
        }
        else if (value == "ENTER")
        {
            FlushCurrentNumber();

            string result = Evaluator.Evaluate(displayTokens);
            displayTokens.Clear();
            if (!string.IsNullOrEmpty(result))
            {
                displayTokens.Add(result);
            }
        }
        else if (char.IsDigit(value[0]) || value == ".")
        {
            currentNumber += value;

            if (value != "0" && value != ".")
            {
                ShuffleDigits();
            }
        }
        else
        {
            FlushCurrentNumber();

            // Unary functions (e.g., "sin(", "cos(", "sqrt(") are split into function name + "("
            if (value.EndsWith("(") && value.Length > 1)
            {
                string funcName = value[..^1];
                displayTokens.Add(funcName);
                displayTokens.Add("(");
            }
            else
            {
                displayTokens.Add(value);
            }
        }
    }
}