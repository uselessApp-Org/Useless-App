@page "/api-search-term"
@rendermode InteractiveServer
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<PageTitle>Dictionary | UselessApp</PageTitle>
<header class="page-heading"><p class="eyebrow">TOOL 04 / STAY CURIOUS</p><h1>Dictionary</h1><p>Look up real definitions using a public dictionary service.</p></header>
<section class="search-container panel">
    <label for="search-term" class="search-label">Word to look up</label>
    <div class="input-group mb-3">
        <input id="search-term" type="text" maxlength="80" placeholder="Try possibility…" class="form-control" @bind="searchTerm" @bind:event="oninput" @onkeydown="OnKeyDown" />
        <button class="btn btn-primary" type="button" @onclick="ExecuteSearch" disabled="@isLoading">@(isLoading ? "Searching…" : "Search")</button>
    </div>
</section>
<section class="result-container panel" aria-live="polite">
    <h2>Search Results</h2>
    @if (!string.IsNullOrEmpty(message)) { <p role="status">@message</p> }
    @if (!string.IsNullOrEmpty(phonetic)) { <p><strong>Pronunciation:</strong> @phonetic</p> }
    @if (definitions.Count > 0)
    {
        <ol>
            @foreach (var definition in definitions) { <li>@definition</li> }
        </ol>
    }
    <small>Uses dictionaryapi.dev by default. Configure DictionaryApi:ApiKey to use Merriam-Webster instead.</small>
</section>

@code {
    private string searchTerm = "";
    private string message = "Enter a word to look it up.";
    private string? phonetic;
    private bool isLoading;
    private readonly List<string> definitions = new();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        if (isLoading) return;
        var term = searchTerm.Trim();
        if (string.IsNullOrWhiteSpace(term)) { message = "Please enter a word."; return; }
        if (term.Length > 80) { message = "Keep the word under 80 characters."; return; }
        isLoading = true;
        definitions.Clear();
        phonetic = null;
        message = "Searching…";
        try
        {
            var apiKey = Configuration["DictionaryApi:ApiKey"];
            var url = string.IsNullOrWhiteSpace(apiKey)
                ? $"https://api.dictionaryapi.dev/api/v2/entries/en/{Uri.EscapeDataString(term)}"
                : $"https://dictionaryapi.com/api/v3/references/collegiate/json/{Uri.EscapeDataString(term)}?key={Uri.EscapeDataString(apiKey)}";
            using var client = HttpClientFactory.CreateClient("dictionary");
            using var response = await client.GetAsync(url);
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                message = $"No definition found for '{term}'.";
                return;
            }
            response.EnsureSuccessStatusCode();
            using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            var root = json.RootElement;
            if (root.ValueKind != JsonValueKind.Array || root.GetArrayLength() == 0)
            {
                message = "No definitions returned.";
                return;
            }
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                foreach (var entry in root.EnumerateArray())
                {
                    if (entry.TryGetProperty("phonetic", out var pronunciation) && pronunciation.ValueKind == JsonValueKind.String)
                        phonetic ??= pronunciation.GetString();
                    if (!entry.TryGetProperty("meanings", out var meanings)) continue;
                    foreach (var meaning in meanings.EnumerateArray())
                    {
                        var part = meaning.TryGetProperty("partOfSpeech", out var p) ? p.GetString() : null;
                        if (!meaning.TryGetProperty("definitions", out var items)) continue;
                        foreach (var item in items.EnumerateArray())
                        {
                            if (item.TryGetProperty("definition", out var definition))
                                definitions.Add($"{part}: {definition.GetString()}");
                            if (definitions.Count >= 10) break;
                        }
                        if (definitions.Count >= 10) break;
                    }
                    if (definitions.Count >= 10) break;
                }
            }
            else
            {
                foreach (var entry in root.EnumerateArray())
                {
                    if (entry.ValueKind != JsonValueKind.Object) continue;
                    if (!entry.TryGetProperty("shortdef", out var shortDefinitions)) continue;
                    foreach (var definition in shortDefinitions.EnumerateArray())
                    {
                        definitions.Add(definition.GetString() ?? "");
                        if (definitions.Count >= 10) break;
                    }
                    if (definitions.Count >= 10) break;
                }
            }
            message = definitions.Count == 0 ? $"No definitions found for '{term}'." : $"Definitions for '{term}':";
        }
        catch (HttpRequestException) { message = "Dictionary service unavailable. Check your network connection and try again."; }
        catch (TaskCanceledException) { message = "Dictionary request timed out. Please retry."; }
        catch (JsonException) { message = "Dictionary returned an unexpected response."; }
        finally { isLoading = false; }
    }
}
