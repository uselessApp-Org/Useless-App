@page "/api-search-term"
@rendermode InteractiveServer
@using System.Net.Http
@using System.Text.Json
@using System.Threading.Tasks
@inject IConfiguration Configuration

<PageTitle>API Search | UselessApp</PageTitle>
<header class="page-heading"><p class="eyebrow">TOOL 04 / STAY CURIOUS</p><h1>API Search</h1><p>Consulting an actual dictionary. Our confidence remains unjustified.</p></header>

<div align="center">
    <div class="search-container panel">
        <label for="search-term" class="search-label">What word are you looking for?</label>
        <div class="input-group mb-3">
            <input id="search-term" placeholder="Try possibility…" type="text" style="color: white"
                class="form-control" 
                @bind="searchTerm" />
        
            <button class="btn btn-primary" type="button" @onclick="ExecuteSearch">
                Search
            </button>
        </div>
    </div>
    
    <div class="result-container panel">
        <h2>Search Results</h2>
        <pre role="status">@jsonString</pre>
    </div>
</div>

@code {
    private const string BaseApiUrl = "https://dictionaryapi.com/api/v3/references/collegiate/json/";

    private string searchTerm = "";
    private string apiResult = "Enter a search term and click Search.";

    string finalUrl = "";
    string jsonString = "";

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            apiResult = "Please enter a search term.";
            return;
        }

        apiResult = $"Looking up something entirely different...";

        //REIMPLEMENT WHEN API KEY IS IMPLEMENTED EXTERNALLY
        //var apiKey = Configuration["DictionaryApi:ApiKey"];
        //if (string.IsNullOrWhiteSpace(apiKey))
        //{
        //    apiResult = "Dictionary connection is not configured yet.";
        //    return;
        //}

        //LOOK FOR ID AND SHORTDEF
        
        string cleanTerm = searchTerm.Trim().ToLowerInvariant();

        await FetchRandomWord();
    }

    public async Task<string> FetchRawHttpDataAsync(string url)
    {
        try
        {
            using HttpClient client = new HttpClient();
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "BlazorApp/1.0");

            using HttpResponseMessage response = await client.SendAsync(request);
            response.EnsureSuccessStatusCode();

            return jsonString = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.Message}";
        }
    }

    public async Task FetchRandomWord()
    {
        using (HttpClient client = new HttpClient())
        {
            try
            {
                string randomWordURL = "https://random-word-api.herokuapp.com/word";
                string randomWordJson = await client.GetStringAsync(randomWordURL);

                finalUrl = $"{BaseApiUrl}{randomWordJson}?key=bb25cd06-abba-40ad-b58e-45c7a44f1910";
                string searchTerm = await client.GetStringAsync(finalUrl);

                apiResult = await FetchRawHttpDataAsync(finalUrl);
            }

            catch (Exception ex)
            {
                apiResult = $"Error: {ex.Message}";
            }
        }
    }
}