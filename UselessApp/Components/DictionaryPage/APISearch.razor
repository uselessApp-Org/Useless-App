@page "/api-search-term"
@rendermode InteractiveServer
@using System.Net.Http
@using System.Text.Json
@using System.Threading.Tasks
@inject IConfiguration Configuration
@inject MerriamAPI merriamAPI
@inject UrbanAPI urbanAPI

<PageTitle>API Search | UselessApp</PageTitle>
<header class="page-heading"><p class="eyebrow">TOOL 04 / STAY CURIOUS</p><h1>API Search</h1><p>Consulting an actual dictionary. Our confidence remains unjustified.</p></header>

<div align="center">
    <div class="search-container panel">
        <label for="search-term" class="search-label">What word are you looking for?</label>
        <div class="input-group mb-3">
            <input id="search-term" placeholder="Try possibility…" type="text" style="color: white"
                class="form-control" 
                @bind="searchTerm" />
        
            <button class="btn btn-primary" type="button" @onclick="ExecuteSearch">
                Search
            </button>
        </div>
    </div>
    
    <div class="result-container panel" style="text-align: left; max-width: 600px, margin-top: 20px">
        <h2>Search Results</h2>
        <p>@apiResult</p>

        @if (!string.IsNullOrEmpty(finalWord))
        {
            <div class="word-card" style="border: 1px solid #444; padding: 15px; border-radius: 8px; background: #222; margin-top: 15px">
                <h3 style="color: #0d6efd; text-transform: capitalize; margin-top: 0;">@finalWord</h3>
                <p style="color: white; font-style: italic;">@finalDescription</p>
            </div>
        }

        @if (suggestions != null && suggestions.Any())
        {
            <div class="suggestion-card" style="border: 1px solid #ffc107; padding: 15px; border-radius: 8px; background: #332701; margin-top: 15px;">
                <h4 style="color: #ffc107; margin-top: 0;">Word Not Found. Did you mean?</h4>
                <ul style="color: white; padding-left: 20px;">
                    @foreach (var word in suggestions)
                    {
                        <li>@word</li>
                    }
                </ul>
            </div>
        }

        <hr style="border-color: #444; margin-top: 30px" />
        <h5>Raw JSON Output</h5>
        <pre role="status" style="background: #111; color: #aaa; padding: 10px; border-radius: 4px; overflow-x: auto; max-height: 200px;">@jsonString</pre>
    </div>
</div>

<div class="form-group">
    <label for="myDropdown">Select an API:</label>
    <select id="myDropdown" class="form-control" @bind="selectedItemValue">
        <option value="">-- Choose an API --</option>
        @if (dropdownOptions != null)
        {
            @foreach (var option in dropdownOptions)
            {
                <option value="@option.Id">@option.Name</option>
            }
        }
    </select>
</div>

<p>Selected API: @selectedItemValue</p>
<br>
<a href="https://www.youtube.com/watch?v=L8XbI9aJOXk" target="_blank" rel="noopener norefferer">Unsatisfied with your search?</a>


@code {
    private const string BaseApiUrl = "https://dictionaryapi.com/api/v3/references/collegiate/json/";

    private string searchTerm = "";
    private string apiResult = "Enter a search term and click Search.";

    string finalUrl = "";
    string jsonString = "";

    string finalWord = "";
    string finalDescription = ""; 

    List<string> suggestions = new List<string>();

    //List<string> results = new List<string>();

    private string selectedItemValue { get; set; } = "Merriam Webster Dictionary";

    private List<DropdownItem> dropdownOptions = new();

    public class DropdownItem
    {
        public string Id { get; set; }
        public string Name { get; set; }
    }

    protected override void OnInitialized()
    {
        dropdownOptions = new List<DropdownItem>
        {
            new DropdownItem { Id = "Merriam Webster Dictionary", Name = "Merriam Webster Dictionary API" },
            new DropdownItem { Id = "Urban Dictionary", Name = "Urban Dictionary API" }
        };
    }    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            apiResult = "Please enter a search term.";
            return;
        }

        apiResult = $"Looking up something entirely different...";

        await FetchRandomWord();
    }

    public async Task FetchRandomWord()
    {
        {
            if (selectedItemValue == "Merriam Webster Dictionary")
            {
                try
                {
                    string randomWordURL = "https://random-word-api.herokuapp.com/word";
                    string randomWordJson = await merriamAPI._httpClient.GetStringAsync(randomWordURL);

                    var wordArray = JsonSerializer.Deserialize<List<string>>(randomWordJson);
                    string cleanWord = wordArray?.FirstOrDefault() ?? "hogmenay";

                    finalUrl = $"https://dictionaryapi.com/api/v3/references/collegiate/json/{randomWordJson}?key={merriamAPI._apiKey}";

                    jsonString = await FetchRawHttpDataAsync(finalUrl);

                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true};
                    var entries = JsonSerializer.Deserialize<List<DictionaryEntry>>(jsonString, options);

                    if (entries != null && entries.Count > 0)
                    {
                        finalWord = entries[0].Meta?.ID;
                        finalDescription = entries[0].ShortDef != null ? string.Join("; ", entries[0].ShortDef) : "No definition found.";

                        apiResult = $"Found something else";
                    }

                    else
                    {
                        apiResult = "No dictionary entries found for this word";
                    }
                }

                catch (Exception ex)
                {
                    apiResult = $"Error: {ex.Message}";
                }
            }

            else if (selectedItemValue == "Urban Dictionary")
            {
                try
                {
                    finalUrl = "https://api.urbandictionary.com/v0/random";

                    jsonString = await urbanAPI._httpClient.GetStringAsync(finalUrl);

                    //jsonString = await FetchRawHttpDataAsync(finalUrl);

                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true};
                    var responseObj = JsonSerializer.Deserialize<UrbanDictionaryResponse>(jsonString, options);

                    if (responseObj?.List != null && responseObj.List.Count > 0)
                    {
                        var firstEntry = responseObj.List[0];

                        finalWord = firstEntry.Word;
                        finalDescription = !string.IsNullOrWhiteSpace(firstEntry.Definition) 
                        ? firstEntry.Definition 
                        : "No definition found.";

                        apiResult = $"Found something else";
                    }

                    else
                    {
                        apiResult = $"No dictionary entries found for this word";
                    }
                } 
                
                catch (Exception ex) 
                {
                    apiResult = $"Error: {ex.Message}";
                }
            }
        }
    }

    public async Task<string> FetchRawHttpDataAsync(string url)
    {
        try
        {
            using HttpClient client = new HttpClient();
            using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "BlazorApp/1.0");

            using HttpResponseMessage response = await client.SendAsync(request);
            response.EnsureSuccessStatusCode();

            return await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.Message}";
        }
    }
}