@page "/movie-recommender"
@using UselessApp.Services
@using UselessApp.model
@inject TMDBService TmdbService
@rendermode InteractiveServer
<div class="tmdb-attribution">
    <img src="/TMDB logo.png"
         alt="TMDB logo"
         width="150" />

    <p>
        This product uses the TMDB API but is not endorsed or certified by TMDB.
    </p>
</div>


<h1>Movie Recommender</h1>

<p>Select a genre:</p>

<select @bind="SelectedGenre">
    <option value="Action">Action</option>
    <option value="Comedy">Comedy</option>
    <option value="Drama">Drama</option>
    <option value="Horror">Horror</option>
    <option value="Romance">Romance</option>
    <option value="SciFi">SciFi</option>
</select>

<button @onclick="RecommendMovie">
    Recommend Movie
</button>

@if (Movie != null)
{
    <h2>@Movie.Title</h2>
    <img src="@Movie.PosterUrl"
         alt="@Movie.Title"
         width="250" />

    <p>@Movie.Overview</p>


}


@code {
    private string SelectedGenre = "Action";
    private MovieRecommendation? Movie;

    private async Task RecommendMovie()
    {
        Movie = await TmdbService.GetMovieRecommendation(
            SelectedGenre);
    }
}