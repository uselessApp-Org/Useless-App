<div id="global-theme-picker" class="theme-picker" data-color-editor data-permanent>
    <span class="theme-label">Theme</span>
    <details class="theme-menu" data-theme-menu>
        <summary aria-label="Choose theme"><span data-theme-label>Theme</span><span aria-hidden="true">⌄</span></summary>
        <div class="theme-options" aria-label="Available themes">
<button type="button" class="theme-option" data-theme-option="seasonal-auto" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Auto season</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<p class="theme-menu-note">Follows your device date. Choose a category to browse.</p>
<details class="theme-category" name="theme-categories"><summary>Animated & wacky <span>6</span></summary><div class="theme-category-options">
<button type="button" class="theme-option" data-theme-option="lava" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Lava lamp liability</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="cosmic" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Cosmic confusion</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="disco" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Disco paperwork</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="aurora" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Aurora bore-why-alis</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="aquarium" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Fish out of office</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="candy" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Candy conveyor</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
</div></details>
<details class="theme-category" name="theme-categories"><summary>Basic themes <span>13</span></summary><div class="theme-category-options">
<button type="button" class="theme-option" data-theme-option="midnight" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Light mode</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="garden" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Dark mode</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="bubblegum" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Bubblegum disaster</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="blueprint" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Bad blueprint</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="sunset" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Sunset incident</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="terminal" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Hacker-ish</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="lavender" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Lavender panic</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="coffee" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Coffee break</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="ocean" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Deeply confused</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="paper" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Paperwork</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="slate" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Slate expectations</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="sand" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Sand in the keyboard</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="cherry" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Cherry-picked results</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
</div></details>
<details class="theme-category" name="theme-categories"><summary>Seasonal themes <span>10</span></summary><div class="theme-category-options">
<button type="button" class="theme-option" data-theme-option="spring" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Pollen panic</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="summer" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Solar-powered nonsense</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="autumn" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Sweater weather</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="winter" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Brain freeze</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="halloween" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Haunted spreadsheet</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="festive" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Festive malfunction</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="valentine" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Questionable romance</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="harvest" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>Gravy emergency</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="newyear" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>New year, same bugs</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
<button type="button" class="theme-option" data-theme-option="rainy" aria-pressed="false"><span class="theme-swatch" aria-hidden="true"></span><span>April showers of errors</span><span class="theme-check" aria-hidden="true">&#10003;</span></button>
</div></details>
<p class="theme-menu-note">Animations respect reduced-motion settings.</p></div>
    </details>
    <select id="theme-choice" hidden aria-hidden="true" tabindex="-1"><option value="seasonal-auto">Auto season</option>
<optgroup label="Animated & wacky"><option value="lava">Lava lamp liability</option><option value="cosmic">Cosmic confusion</option><option value="disco">Disco paperwork</option><option value="aurora">Aurora bore-why-alis</option><option value="aquarium">Fish out of office</option><option value="candy">Candy conveyor</option></optgroup>
<optgroup label="Basic themes"><option value="midnight">Light mode</option><option value="garden">Dark mode</option><option value="bubblegum">Bubblegum disaster</option><option value="blueprint">Bad blueprint</option><option value="sunset">Sunset incident</option><option value="terminal">Hacker-ish</option><option value="lavender">Lavender panic</option><option value="coffee">Coffee break</option><option value="ocean">Deeply confused</option><option value="paper">Paperwork</option><option value="slate">Slate expectations</option><option value="sand">Sand in the keyboard</option><option value="cherry">Cherry-picked results</option></optgroup>
<optgroup label="Seasonal themes"><option value="spring">Pollen panic</option><option value="summer">Solar-powered nonsense</option><option value="autumn">Sweater weather</option><option value="winter">Brain freeze</option><option value="halloween">Haunted spreadsheet</option><option value="festive">Festive malfunction</option><option value="valentine">Questionable romance</option><option value="harvest">Gravy emergency</option><option value="newyear">New year, same bugs</option><option value="rainy">April showers of errors</option></optgroup>
</select>
    <div class="accent-control">
        <button type="button" class="accent-dot accent-square-toggle" data-accent-dot data-custom-color-enabled aria-pressed="false" aria-label="Enable custom color" title="Enable custom color"><svg data-custom-color-state aria-hidden="true" viewBox="0 0 24 24" focusable="false"><g class="color-state-on"><path class="symbol-outline" d="M5 12l4 4L19 6" /><path class="symbol-ink" d="M5 12l4 4L19 6" /></g><g class="color-state-off"><path class="symbol-outline" d="M6 6l12 12M18 6L6 18" /><path class="symbol-ink" d="M6 6l12 12M18 6L6 18" /></g></svg></button>
        <button type="button" class="accent-trigger" data-color-toggle aria-expanded="false" aria-controls="accent-panel" title="Choose custom color">Colors</button>
    </div>
    <section id="accent-panel" class="accent-panel" aria-label="Theme color editor" hidden>
        <div class="accent-panel-head"><strong>Custom accent color</strong><button type="button" class="accent-icon-btn" data-color-close aria-label="Close color editor">✕</button></div>
        <p class="accent-note">Choose a color on the wheel. Open advanced options to fine tune it.</p>
        <div class="accent-wheel" data-color-wheel role="slider" tabindex="0" aria-label="Color wheel: arrows change hue and saturation" aria-valuemin="0" aria-valuemax="360"><span data-wheel-marker></span></div>
        <div class="accent-color-preview" data-color-preview aria-label="Selected color preview"></div>
        <details class="accent-advanced"><summary>Advanced color options</summary>
        <div class="accent-slider-row"><label for="accent-hue">Hue</label><input id="accent-hue" data-hue type="range" min="0" max="360" value="160" /></div>
        <div class="accent-slider-row"><label for="accent-saturation">Saturation</label><input id="accent-saturation" data-saturation type="range" min="0" max="100" value="50" /></div>
        <div class="accent-slider-row"><label for="accent-lightness">Lightness</label><input id="accent-lightness" data-lightness type="range" min="0" max="100" value="44" /></div>
        <div class="accent-panel-row"><label for="accent-hex">Hex</label><input id="accent-hex" data-hex class="form-control accent-hex" maxlength="7" placeholder="#35a884" spellcheck="false" autocapitalize="off" autocomplete="off" /></div>
        <div class="accent-panel-row accent-tools">
            <button type="button" class="accent-tool" data-save-color>+ Save</button>
            <button type="button" class="accent-tool" data-reset-color>Reset</button>
        </div>
        <div class="accent-panel-row accent-tools">
            <button type="button" class="accent-tool" data-screen-pick hidden>◉ Screen eyedropper</button>
            <label class="accent-tool accent-upload" for="accent-image">📷 Pick from a photo</label>
            <input id="accent-image" data-image-upload type="file" accept="image/*" class="accent-hidden-file" />
        </div>
        <div class="accent-image-area" data-image-area hidden>
            <p class="accent-note">Tap or click a spot in the photo to sample that color. Photos stay on your device.</p>
            <canvas data-image-canvas aria-label="Photo color sampler" tabindex="0"></canvas>
            <button type="button" class="accent-tool" data-close-image>Close photo</button>
        </div>
        </details>
        <div class="accent-swatch-list" data-saved-colors aria-label="Saved colors"></div>
        <p class="accent-note" role="status" aria-live="polite" data-color-status></p>
    </section>
</div>
