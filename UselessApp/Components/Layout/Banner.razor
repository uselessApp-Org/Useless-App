@inject DisplayNameService DisplayNameService
@inject  NavigationManager nav
@rendermode InteractiveServer

<div class="account-shell">
<input id="account-toggle" class="mobile-control-toggle" type="checkbox" aria-label="Show account options" aria-controls="account-controls" />
<label class="mobile-control-label" for="account-toggle"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg><span>Account</span><span class="control-chevron" aria-hidden="true">&#8964;</span></label>
<div id="account-controls" class="login-container">
    @if (DisplayNameService.IsLoggedIn)
    {
        <span class="user-display">
            @(DisplayNameService.RandomDisplayName 
              ?? DisplayNameService.DisplayName 
              ?? DisplayNameService.Username)

        </span>
        <a href="#" @onclick="Logout">Logout</a>

    }
    else
    {
        <a href="/signup">Sign Up</a>
        <a href="/login">Login</a>
    }
</div>
</div>

@code {
    private async Task Logout()
    {
        await DisplayNameService.LogoutAsync();
            nav.NavigateTo("/");

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            DisplayNameService.OnChange += StateHasChanged;
            await DisplayNameService.LoadUserAsync();
        }
    }
}
