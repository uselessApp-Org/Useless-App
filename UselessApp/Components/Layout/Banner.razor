@inject DisplayNameService DisplayNameService
@inject NavigationManager nav
@rendermode InteractiveServer

<div class="user-menu">
    @if (DisplayNameService.IsLoggedIn)
    {
        <button class="user-menu-trigger" @onclick="ToggleMenu">
            @DisplayNameService.RandomDisplayName
        </button>
        @if (menuOpen)
        {
           <div class="user-menu-dropdown">
    <a class="dropdown-link" href="/profile">Profile</a>

    <button class="dropdown-link" @onclick="Logout">Logout</button>
</div>


        }


        
    }
    else
    {
        <a href="/signup">Sign Up</a>
        <a href="/login">Login</a>
    }
</div>

</div>

@code {
    private bool menuOpen = false;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void NavigateTo(string url)
    {
        menuOpen = false;
        nav.NavigateTo(url);
    }

    private async Task Logout()
    {
        menuOpen = false;
        await DisplayNameService.LogoutAsync();
        nav.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            DisplayNameService.OnChange += StateHasChanged;
            await DisplayNameService.LoadUserAsync();
        }
    }
}
