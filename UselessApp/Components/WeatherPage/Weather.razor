@page "/weather"
@rendermode InteractiveServer
@using System.Text.Json
@using UselessApp.Components.WeatherPage.Components
@inject WeatherService WeatherService

<PageTitle>Weather</PageTitle>

<div class="weather-page">
    @if (showLocationPrompt)
    {
        <LocationPrompt CanCancel="hasLocation" OnCancel="() => showLocationPrompt = false" OnLocationSelected="SetLocation" />
    }

    <section class="weather-card radar-panel" aria-label="Geolocation result" inert="@showLocationPrompt">
        <div class="eyebrow">GEOLOCATION RESULT</div>
        @if (selectedLocation is null)
        {
            <p>No location selected yet.</p>
        }
        else
        {
            <pre class="location-json">@JsonSerializer.Serialize(selectedLocation, new JsonSerializerOptions { WriteIndented = true })</pre>
        }

        <div class="eyebrow">WEATHER POINT DATA</div>
        @if (weatherPointError is not null)
        {
            <p class="location-error">@weatherPointError</p>
        }
        else if (weatherPoint is null)
        {
            <p>No weather point data yet.</p>
        }
        else
        {
            <pre class="location-json">@JsonSerializer.Serialize(weatherPoint, new JsonSerializerOptions { WriteIndented = true })</pre>
        }
    </section>

    <section class="weather-card info-panel" aria-label="Current conditions" inert="@showLocationPrompt">
        <CurrentConditionsPanel CurrentForecast="@RealHourlyForecast" Astronomy="@weatherPoint?.AstronomicalData" Location="@location" LastUpdated="@lastUpdated" OnChangeLocation="OpenLocationPrompt" />
    </section>

    <section class="weather-card forecast-panel" aria-label="Forecast" inert="@showLocationPrompt">
        <ForecastPanel Hourly="hourly" Daily="daily" />
    </section>
</div>