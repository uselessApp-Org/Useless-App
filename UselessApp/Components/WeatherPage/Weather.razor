@page "/weather"
@rendermode InteractiveServer

<PageTitle>Weather</PageTitle>

<div class="weather-page">
    <section class="weather-card radar-panel" aria-label="Weather radar">
        <div class="eyebrow">WEATHER RADAR</div>
        <div class="radar" aria-hidden="true">
            <div class="radar-ring ring-one"></div>
            <div class="radar-ring ring-two"></div>
            <div class="radar-ring ring-three"></div>
            <div class="radar-cross"></div>
            <div class="storm storm-light" style="top: 22%; left: 30%;"></div>
            <div class="storm storm-medium" style="top: 55%; left: 62%;"></div>
            <div class="storm storm-heavy" style="top: 60%; left: 66%;"></div>
            <div class="storm storm-light" style="top: 70%; left: 20%;"></div>
            <div class="radar-sweep"></div>
            <div class="radar-center"></div>
        </div>
        <p class="radar-caption">Radar is 100% accurate about weather happening somewhere.</p>
    </section>

    <section class="weather-card info-panel" aria-label="Current conditions">
        <div class="eyebrow">CURRENT CONDITIONS</div>
        <h2 class="location">@location</h2>
        <p class="updated">Last updated @lastUpdated</p>

        <div class="current-temp">
            <span class="current-icon" aria-hidden="true">@conditionIcon</span>
            <span>@(currentTemp)°</span>
        </div>
        <p class="condition">@condition</p>

        <dl class="stats">
            <div>
                <dt>Humidity</dt>
                <dd>@(humidity)%</dd>
            </div>
            <div>
                <dt>Wind</dt>
                <dd>
                    <span class="wind-arrow" style="transform: rotate(@(windDeg)deg);" aria-hidden="true">↑</span>
                    @windDirection @windSpeed mph
                </dd>
            </div>
            <div>
                <dt>Feels like</dt>
                <dd>@(feelsLike)°</dd>
            </div>
        </dl>
    </section>

    <section class="weather-card forecast-panel" aria-label="Forecast">
        <div class="forecast-options" role="group" aria-label="Forecast range">
            <button type="button" class="mode-button" aria-pressed="@(!showDaily)" @onclick="() => SetMode(false)">Hourly</button>
            <button type="button" class="mode-button" aria-pressed="@showDaily" @onclick="() => SetMode(true)">Daily</button>
        </div>

        <ul class="forecast-strip">
            @foreach (var item in showDaily ? daily : hourly)
            {
                <li class="forecast-card">
                    <span class="forecast-label">@item.Label</span>
                    <span class="forecast-icon" aria-hidden="true">@item.Icon</span>
                    <span class="forecast-temp">
                        @(item.Temp)°
                        @if (item.Low is not null)
                        {
                            <small>@(item.Low)°</small>
                        }
                    </span>
                    <span class="forecast-precip">💧 @(item.PrecipChance)%</span>
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private record ForecastItem(string Label, string Icon, int Temp, int? Low, int PrecipChance);

    // Sample data until the weather API is wired up
    private string location = "Menomonie, WI";
    private string lastUpdated = DateTime.Now.ToString("h:mm tt");
    private int currentTemp = 58;
    private string condition = "Partly Indecisive";
    private string conditionIcon = "⛅";
    private int humidity = 64;
    private string windDirection = "NW";
    private int windDeg = 315;
    private int windSpeed = 12;
    private int feelsLike = 55;

    private readonly string[] icons = { "☀", "⛅", "☁", "🌧", "⛈", "🌨" };
    private List<ForecastItem> hourly = new();
    private List<ForecastItem> daily = new();
    private bool showDaily = false;

    protected override void OnInitialized()
    {
        var rng = new Random(69);
        var now = DateTime.Now;

        for (int i = 0; i < 24; i++)
        {
            string label = i == 0 ? "Now" : now.AddHours(i).ToString("h tt");
            hourly.Add(new ForecastItem(label, icons[rng.Next(icons.Length)], rng.Next(45, 66), null, rng.Next(0, 101)));
        }

        for (int i = 0; i < 7; i++)
        {
            string label = i == 0 ? "Today" : now.AddDays(i).ToString("ddd");
            int high = rng.Next(50, 72);
            daily.Add(new ForecastItem(label, icons[rng.Next(icons.Length)], high, high - rng.Next(8, 18), rng.Next(0, 101)));
        }
    }

    private void SetMode(bool daily)
    {
        showDaily = daily;
    }
}
