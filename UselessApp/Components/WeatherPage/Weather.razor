@page "/weather"
@rendermode InteractiveServer
@using UselessApp.Components.WeatherPage.Components
@inject WeatherService WeatherService
@inject RandomUSCoordsService RandomCoordsService;
@inject RainViewerService RainViewerService

<PageTitle>Weather</PageTitle>

<div class="weather-page">
    @if (showLocationPrompt)
    {
        <LocationPrompt CanCancel="hasLocation" OnCancel="() => showLocationPrompt = false" OnLocationSelected="SetLocation" />
    }

    <section class="weather-card radar-panel" aria-label="Radar" inert="@showLocationPrompt">
        @if (radarError is not null)
        {
            <div class="eyebrow">RADAR</div>
            <p class="location-error" role="alert">@radarError</p>
        }
        else
        {
            <RadarPanel Maps="@radarMaps" Latitude="@selectedLocation?.Latitude" Longitude="@selectedLocation?.Longitude" Location="@location" />
        }
    </section>

    <section class="weather-card info-panel" aria-label="Current conditions" inert="@showLocationPrompt">
        @if (errorMessage is not null)
        {
            <p class="location-error" role="alert">@errorMessage</p>
        }
        <CurrentConditionsPanel CurrentForecast="@RealHourlyForecast" Astronomy="@weatherPoint?.AstronomicalData" Location="@location" LastUpdated="@lastUpdated" OnChangeLocation="OpenLocationPrompt" />
    </section>

    <section class="weather-card forecast-panel" aria-label="Forecast" inert="@showLocationPrompt">
        @if (forecastError is not null)
        {
            <div class="eyebrow">FORECAST</div>
            <p class="location-error" role="alert">@forecastError</p>
        }
        else
        {
            <ForecastPanel forecastDataHourly="@BadHourlyForecast" forecastDataDaily="@BadDailyForecast" />
        }
    </section>
</div>