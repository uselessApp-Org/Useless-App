@inject WeatherService WeatherService

<div class="eyebrow">CURRENT CONDITIONS</div>
<h2 class="location">@Location</h2>
<button type="button" class="change-location" @onclick="OnChangeLocation">Change location</button>
<p class="updated">Last updated @LastUpdated</p>

<div class="current-temp">
    
    <span>@(CurrentData?.temperature)°@(CurrentData?.temperatureUnit)</span>
</div>
<p class="condition">@CurrentData?.name</p>

<dl class="stats">
    <div>
        <dt>Wind</dt>
        <dd>
            <span>@(CurrentData?.iconURL)</span>
            @CurrentData?.windDirection @CurrentData?.windSpeed mph
        </dd>
    </div>
    <div>
        <dt>Weather Description</dt>
        <dd>@CurrentData?.shortForecast</dd>
    </div>
</dl>

@code {
    [Parameter]
    public string LastUpdated { get; set; } = string.Empty;

    [Parameter]
    public string Location { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnChangeLocation { get; set; }

    [Parameter]
    public ForecastData? CurrentForecast {get; set; }

    [Parameter]
    public HourlyPeriod? CurrentData { get; set; }


    private void SetCurrentData()
    {
        CurrentData = CurrentForecast?.hourlyPeriods[0];
    }
}
