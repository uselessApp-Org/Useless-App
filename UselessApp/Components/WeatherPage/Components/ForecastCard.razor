<li class="forecast-card">
    <span class="forecast-label">@(period?.name == null ? @period?.hourNumber : @period.name)</span>
    <span class="forecast-temp">
        @(period?.temperature)°
    </span>
    <span class="forecast-precip">💧 @(period?.precipProb?.precipValue)%</span>
    <span>@period?.windDirection @period?.windSpeed</span>
</li>

@code {
    [Parameter]
    public HourlyPeriod? period {get; set; }
}
