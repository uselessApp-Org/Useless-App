@page "/profile"
@using UselessApp.Services
@using UselessApp.Models

@inject MongodbUserService MongodbUser
@inject DisplayNameService DisplayNameService



<h1>@DisplayNameService.RandomDisplayName</h1>
<h2>Calculator </h2>
<div class="stat-row">
    <div class="stat-box">
        <div class="stat-value">@NumEnters</div>
        <div class="stat-label">Times enter has been hit</div>
    </div>

    <div class="stat-box">
        <div class="Latest-Expression">@(string.IsNullOrEmpty(LatestExpression) ? "69 + 420" : LatestExpression)</div>
        <div class="stat-label">Latest expression</div>
    </div>

    <div class="stat-box">
        <div class="Latest-Answer">@(string.IsNullOrEmpty(LatestAnswer) ? 69420 : LatestAnswer)</div>
        <div class="stat-label">Latest answer</div>
    </div>
</div>
<div class="splitter"></div>
<h2>AI</h2>
<div class="stat-row">
    <div class="stat-box">
        <div class="AIvalue">0 </div>
        <div class="stat-label">Amount of times AskAi has been interacted with</div>
    </div>
    <div class="stat-box">
        <div class="Ai-LastExpression">Help me</div>
        <div class="stat-label">Latest AI expression</div>
    </div>
    <div class="stat-box">
        <div class="Ai-LastAnswer">42</div>
        <div class="stat-label">Latest AI answer</div>
    </div>
</div>
@code {

    [Parameter] public string Value { get; set; }
    [Parameter] public string LatestExpression { get; set; }
    [Parameter] public string LatestAnswer { get; set; }
    [Parameter] public string AIvalue { get; set; }
    [Parameter] public string AiLastExpression { get; set; }
    [Parameter] public string AiLastAnswer { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await DisplayNameService.LoadUserAsync();
            StateHasChanged();
        }
    }
}

    [Parameter] public int NumEnters { get; set; }
    [Parameter] public string LatestExpression { get; set; } = string.Empty;
    [Parameter] public string LatestAnswer { get; set; } = string.Empty;
    [Parameter] public string AIvalue { get; set; } = string.Empty;
    [Parameter] public string AiLastExpression { get; set; } = string.Empty;
    [Parameter] public string AiLastAnswer { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;

        if(!DisplayNameService.IsLoggedIn)
            await DisplayNameService.LoadUserAsync();
        
        await LoadProfileDataAsync();
        StateHasChanged();
    }

    private async Task LoadProfileDataAsync()
    {
        if(!DisplayNameService.IsLoggedIn) return;

        User? curUser = await MongodbUser.GetUserDataForProfilePage(DisplayNameService.Username);

        if(curUser is null) return;

        LatestAnswer = curUser.LastResult;
        LatestExpression = curUser.LastExpression;
        NumEnters = curUser.Enters;
    }
}
