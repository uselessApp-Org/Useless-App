@page "/profile"
@using UselessApp.Services
@using UselessApp.Models


@inject DisplayNameService DisplayNameService
<h2>Calculator @DisplayNameService.RandomDisplayName</h2>
<div class="stat-row">
    <div class="stat-box">
        <div class="stat-value">0</div>
        <div class="stat-label">Times enter has been hit</div>
    </div>

    <div class="stat-box">
        <div class="Latest-Expression">2+2</div>
        <div class="stat-label">Latest expression</div>
    </div>

    <div class="stat-box">
        <div class="Latest-Answer">36724</div>
        <div class="stat-label">Latest answer</div>
    </div>
</div>
<div class="splitter"></div>
<h2>AI</h2>
<div class="stat-row">
<div class="stat-box">
    <div class="AIvalue">0 </div>
    <div class="stat-label">Amount of times AskAi has been interacted with</div>
</div>
<div class="stat-box">
    <div class="Ai-LastExpression">Help me</div>
    <div class="stat-label">Latest AI expression</div>
</div>
<div class="stat-box">
    <div class="Ai-LastAnswer">42</div>
    <div class="stat-label">Latest AI answer</div>
</div>
</div>
@code {
   
    [Parameter] public string Value { get; set; }
    [Parameter] public string LatestExpression { get; set; }
    [Parameter] public string LatestAnswer { get; set; }
    [Parameter] public string AIvalue { get; set; }
    [Parameter] public string AiLastExpression { get; set; }
    [Parameter] public string AiLastAnswer { get; set; }
}



