<button class="@Style"
    @onclick="ButtonClicked">
    @Number
</button>

@code{
    [Parameter]
    public string Style { get; set; } = "NumButton";

    [Parameter]
    public int Number { get; set; }

    [Parameter]
    public EventCallback<int> Clicked { get; set; }

    private async Task ButtonClicked()
    {
        await Clicked.InvokeAsync(Number);
    }
}